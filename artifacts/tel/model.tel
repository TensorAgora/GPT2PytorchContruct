# The forward pass of "distilbert/distilgpt2", one block at a time.
# Generated by @tensormorph/tensorparser from the checkpoint, adapter gpt2@1.

axis B
axis T
axis D : hidden = 768
axis H : head = 12
axis D_h : headDim = 64
axis F : feature = 3072
axis V : vocabulary = 50257
axis P : sequence = 1024
axis QKV = 2304
axis Dc : channel = 768
axis q : query = T
axis k : key = T

E : f32[V,D]
Wp : f32[P,D]
gf : f32[D]
bf : f32[D]
ids : i64[B,T]
pos : i64[T]

g1_0 : f32[D]
b1_0 : f32[D]
W_qkv_0 : f32[D,QKV]
b_qkv_0 : f32[QKV]
W_o_0 : f32[Dc,D]
b_o_0 : f32[D]
g2_0 : f32[D]
b2_0 : f32[D]
W_fc_0 : f32[D,F]
b_fc_0 : f32[F]
W_pr_0 : f32[F,D]
b_pr_0 : f32[D]
Mb_0 : f32[q,k]

g1_1 : f32[D]
b1_1 : f32[D]
W_qkv_1 : f32[D,QKV]
b_qkv_1 : f32[QKV]
W_o_1 : f32[Dc,D]
b_o_1 : f32[D]
g2_1 : f32[D]
b2_1 : f32[D]
W_fc_1 : f32[D,F]
b_fc_1 : f32[F]
W_pr_1 : f32[F,D]
b_pr_1 : f32[D]
Mb_1 : f32[q,k]

g1_2 : f32[D]
b1_2 : f32[D]
W_qkv_2 : f32[D,QKV]
b_qkv_2 : f32[QKV]
W_o_2 : f32[Dc,D]
b_o_2 : f32[D]
g2_2 : f32[D]
b2_2 : f32[D]
W_fc_2 : f32[D,F]
b_fc_2 : f32[F]
W_pr_2 : f32[F,D]
b_pr_2 : f32[D]
Mb_2 : f32[q,k]

g1_3 : f32[D]
b1_3 : f32[D]
W_qkv_3 : f32[D,QKV]
b_qkv_3 : f32[QKV]
W_o_3 : f32[Dc,D]
b_o_3 : f32[D]
g2_3 : f32[D]
b2_3 : f32[D]
W_fc_3 : f32[D,F]
b_fc_3 : f32[F]
W_pr_3 : f32[F,D]
b_pr_3 : f32[D]
Mb_3 : f32[q,k]

g1_4 : f32[D]
b1_4 : f32[D]
W_qkv_4 : f32[D,QKV]
b_qkv_4 : f32[QKV]
W_o_4 : f32[Dc,D]
b_o_4 : f32[D]
g2_4 : f32[D]
b2_4 : f32[D]
W_fc_4 : f32[D,F]
b_fc_4 : f32[F]
W_pr_4 : f32[F,D]
b_pr_4 : f32[D]
Mb_4 : f32[q,k]

g1_5 : f32[D]
b1_5 : f32[D]
W_qkv_5 : f32[D,QKV]
b_qkv_5 : f32[QKV]
W_o_5 : f32[Dc,D]
b_o_5 : f32[D]
g2_5 : f32[D]
b2_5 : f32[D]
W_fc_5 : f32[D,F]
b_fc_5 : f32[F]
W_pr_5 : f32[F,D]
b_pr_5 : f32[D]
Mb_5 : f32[q,k]

# The residual stream enters as the token embedding plus the position embedding.
X_0 = E[ids] + Wp[pos]

# block 0
N1_0 = layernorm(X_0, axis=D, eps=0.00001) * g1_0 + b1_0
Hq_0 = N1_0 @ W_qkv_0 + b_qkv_0
Q_0 = relabel(permute(reshape(Hq_0[:, :, 0:768], [B,T,H,D_h]), [0,2,1,3]), T -> q)
K_0 = relabel(permute(reshape(Hq_0[:, :, 768:1536], [B,T,H,D_h]), [0,2,1,3]), T -> k)
V_0 = relabel(permute(reshape(Hq_0[:, :, 1536:2304], [B,T,H,D_h]), [0,2,1,3]), T -> k)
S_0 = Q_0 @ K_0.T / sqrt(D_h)
A_0 = softmax(S_0 + log(Mb_0), axis=k)
C_0 = A_0 @ V_0
O_0 = reshape(permute(relabel(C_0, q -> T), [0,2,1,3]), [B,T,Dc]) @ W_o_0 + b_o_0
Xm_0 = X_0 + O_0
N2_0 = layernorm(Xm_0, axis=D, eps=0.00001) * g2_0 + b2_0
G_0 = N2_0 @ W_fc_0 + b_fc_0
M_0 = (0.5 * G_0 * (1 + tanh(0.7978845608 * (G_0 + 0.044715 * G_0 ^ 3)))) @ W_pr_0 + b_pr_0
X_1 = Xm_0 + M_0

# block 1
N1_1 = layernorm(X_1, axis=D, eps=0.00001) * g1_1 + b1_1
Hq_1 = N1_1 @ W_qkv_1 + b_qkv_1
Q_1 = relabel(permute(reshape(Hq_1[:, :, 0:768], [B,T,H,D_h]), [0,2,1,3]), T -> q)
K_1 = relabel(permute(reshape(Hq_1[:, :, 768:1536], [B,T,H,D_h]), [0,2,1,3]), T -> k)
V_1 = relabel(permute(reshape(Hq_1[:, :, 1536:2304], [B,T,H,D_h]), [0,2,1,3]), T -> k)
S_1 = Q_1 @ K_1.T / sqrt(D_h)
A_1 = softmax(S_1 + log(Mb_1), axis=k)
C_1 = A_1 @ V_1
O_1 = reshape(permute(relabel(C_1, q -> T), [0,2,1,3]), [B,T,Dc]) @ W_o_1 + b_o_1
Xm_1 = X_1 + O_1
N2_1 = layernorm(Xm_1, axis=D, eps=0.00001) * g2_1 + b2_1
G_1 = N2_1 @ W_fc_1 + b_fc_1
M_1 = (0.5 * G_1 * (1 + tanh(0.7978845608 * (G_1 + 0.044715 * G_1 ^ 3)))) @ W_pr_1 + b_pr_1
X_2 = Xm_1 + M_1

# block 2
N1_2 = layernorm(X_2, axis=D, eps=0.00001) * g1_2 + b1_2
Hq_2 = N1_2 @ W_qkv_2 + b_qkv_2
Q_2 = relabel(permute(reshape(Hq_2[:, :, 0:768], [B,T,H,D_h]), [0,2,1,3]), T -> q)
K_2 = relabel(permute(reshape(Hq_2[:, :, 768:1536], [B,T,H,D_h]), [0,2,1,3]), T -> k)
V_2 = relabel(permute(reshape(Hq_2[:, :, 1536:2304], [B,T,H,D_h]), [0,2,1,3]), T -> k)
S_2 = Q_2 @ K_2.T / sqrt(D_h)
A_2 = softmax(S_2 + log(Mb_2), axis=k)
C_2 = A_2 @ V_2
O_2 = reshape(permute(relabel(C_2, q -> T), [0,2,1,3]), [B,T,Dc]) @ W_o_2 + b_o_2
Xm_2 = X_2 + O_2
N2_2 = layernorm(Xm_2, axis=D, eps=0.00001) * g2_2 + b2_2
G_2 = N2_2 @ W_fc_2 + b_fc_2
M_2 = (0.5 * G_2 * (1 + tanh(0.7978845608 * (G_2 + 0.044715 * G_2 ^ 3)))) @ W_pr_2 + b_pr_2
X_3 = Xm_2 + M_2

# block 3
N1_3 = layernorm(X_3, axis=D, eps=0.00001) * g1_3 + b1_3
Hq_3 = N1_3 @ W_qkv_3 + b_qkv_3
Q_3 = relabel(permute(reshape(Hq_3[:, :, 0:768], [B,T,H,D_h]), [0,2,1,3]), T -> q)
K_3 = relabel(permute(reshape(Hq_3[:, :, 768:1536], [B,T,H,D_h]), [0,2,1,3]), T -> k)
V_3 = relabel(permute(reshape(Hq_3[:, :, 1536:2304], [B,T,H,D_h]), [0,2,1,3]), T -> k)
S_3 = Q_3 @ K_3.T / sqrt(D_h)
A_3 = softmax(S_3 + log(Mb_3), axis=k)
C_3 = A_3 @ V_3
O_3 = reshape(permute(relabel(C_3, q -> T), [0,2,1,3]), [B,T,Dc]) @ W_o_3 + b_o_3
Xm_3 = X_3 + O_3
N2_3 = layernorm(Xm_3, axis=D, eps=0.00001) * g2_3 + b2_3
G_3 = N2_3 @ W_fc_3 + b_fc_3
M_3 = (0.5 * G_3 * (1 + tanh(0.7978845608 * (G_3 + 0.044715 * G_3 ^ 3)))) @ W_pr_3 + b_pr_3
X_4 = Xm_3 + M_3

# block 4
N1_4 = layernorm(X_4, axis=D, eps=0.00001) * g1_4 + b1_4
Hq_4 = N1_4 @ W_qkv_4 + b_qkv_4
Q_4 = relabel(permute(reshape(Hq_4[:, :, 0:768], [B,T,H,D_h]), [0,2,1,3]), T -> q)
K_4 = relabel(permute(reshape(Hq_4[:, :, 768:1536], [B,T,H,D_h]), [0,2,1,3]), T -> k)
V_4 = relabel(permute(reshape(Hq_4[:, :, 1536:2304], [B,T,H,D_h]), [0,2,1,3]), T -> k)
S_4 = Q_4 @ K_4.T / sqrt(D_h)
A_4 = softmax(S_4 + log(Mb_4), axis=k)
C_4 = A_4 @ V_4
O_4 = reshape(permute(relabel(C_4, q -> T), [0,2,1,3]), [B,T,Dc]) @ W_o_4 + b_o_4
Xm_4 = X_4 + O_4
N2_4 = layernorm(Xm_4, axis=D, eps=0.00001) * g2_4 + b2_4
G_4 = N2_4 @ W_fc_4 + b_fc_4
M_4 = (0.5 * G_4 * (1 + tanh(0.7978845608 * (G_4 + 0.044715 * G_4 ^ 3)))) @ W_pr_4 + b_pr_4
X_5 = Xm_4 + M_4

# block 5
N1_5 = layernorm(X_5, axis=D, eps=0.00001) * g1_5 + b1_5
Hq_5 = N1_5 @ W_qkv_5 + b_qkv_5
Q_5 = relabel(permute(reshape(Hq_5[:, :, 0:768], [B,T,H,D_h]), [0,2,1,3]), T -> q)
K_5 = relabel(permute(reshape(Hq_5[:, :, 768:1536], [B,T,H,D_h]), [0,2,1,3]), T -> k)
V_5 = relabel(permute(reshape(Hq_5[:, :, 1536:2304], [B,T,H,D_h]), [0,2,1,3]), T -> k)
S_5 = Q_5 @ K_5.T / sqrt(D_h)
A_5 = softmax(S_5 + log(Mb_5), axis=k)
C_5 = A_5 @ V_5
O_5 = reshape(permute(relabel(C_5, q -> T), [0,2,1,3]), [B,T,Dc]) @ W_o_5 + b_o_5
Xm_5 = X_5 + O_5
N2_5 = layernorm(Xm_5, axis=D, eps=0.00001) * g2_5 + b2_5
G_5 = N2_5 @ W_fc_5 + b_fc_5
M_5 = (0.5 * G_5 * (1 + tanh(0.7978845608 * (G_5 + 0.044715 * G_5 ^ 3)))) @ W_pr_5 + b_pr_5
X_6 = Xm_5 + M_5

# The final norm, and the unembedding, which is the embedding read the other way.
Xf = layernorm(X_6, axis=D, eps=0.00001) * gf + bf
L = Xf @ E.T
