{
  "category": "multimodal_vlm",
  "row_counts_by_format": {
    "gguf": 903,
    "onnx": 5,
    "pytorch": 26,
    "safetensors": 2101
  },
  "graph": "vision (and/or audio) encoder -> projector -> decoder LM; pick the LM dims block from model_type / lm_model_type / graph_flags (dense, moe, mla, hybrid)",
  "dims": {
    "D": [
      "hidden_size | n_embd (GPT-2)",
      "<arch>.embedding_length"
    ],
    "V": [
      "vocab_size",
      "<arch>.vocab_size | len(tokenizer.ggml.tokens)"
    ],
    "F": [
      "intermediate_size | n_inner (GPT-2; null = 4*D)",
      "<arch>.feed_forward_length"
    ],
    "H": [
      "GQA (Hkv present): (num_attention_heads | n_head) / (num_key_value_heads (default = Hq)) = query heads per KV group; MHA/GPT-2: num_attention_heads | n_head",
      "<arch>.attention.head_count / <arch>.attention.head_count_kv (GQA); <arch>.attention.head_count (MHA)"
    ],
    "Hkv": [
      "num_key_value_heads (default = Hq)",
      "<arch>.attention.head_count_kv"
    ],
    "Dh": [
      "head_dim (default hidden_size/num_attention_heads)",
      "<arch>.attention.key_length (else embedding_length / attention.head_count)"
    ],
    "Dh2": [
      "= Dh (second label of the same size, for q.k^T score axes)",
      "= Dh"
    ],
    "Dq": [
      "Hq * Dh",
      "<arch>.attention.head_count * Dh"
    ],
    "Dkv": [
      "Hkv * Dh",
      "<arch>.attention.head_count_kv * Dh"
    ],
    "P": [
      "max_position_embeddings | n_positions (GPT-2; learned position table)",
      "<arch>.context_length"
    ],
    "Dc": [
      "= D (GPT-2 Conv1D projection width)",
      "= D"
    ],
    "QKV": [
      "3 * D (GPT-2 fused c_attn)",
      "attn_qkv tensor shape"
    ]
  },
  "dims_moe": {
    "E": [
      "num_local_experts | n_routed_experts | num_experts",
      "<arch>.expert_count"
    ],
    "Fe": [
      "moe_intermediate_size (Mixtral: intermediate_size)",
      "<arch>.expert_feed_forward_length (else <arch>.feed_forward_length)"
    ]
  },
  "dims_mla": {
    "H": [
      "num_attention_heads",
      "<arch>.attention.head_count"
    ],
    "QR": [
      "q_lora_rank",
      "<arch>.attention.q_lora_rank"
    ],
    "Dn": [
      "qk_nope_head_dim",
      "Dqk - Dr"
    ],
    "Dr": [
      "qk_rope_head_dim",
      "<arch>.rope.dimension_count"
    ],
    "Dr2": [
      "= Dr",
      "= Dr"
    ],
    "Dqk": [
      "Dn + Dr",
      "<arch>.attention.key_length_mla (older files: <arch>.attention.key_length)"
    ],
    "QH": [
      "H * Dqk",
      "H * Dqk"
    ],
    "KR": [
      "kv_lora_rank",
      "<arch>.attention.kv_lora_rank"
    ],
    "KA": [
      "KR + Dr (kv_a_proj_with_mqa width)",
      "KR + Dr"
    ],
    "Dv": [
      "v_head_dim",
      "<arch>.attention.value_length_mla (older files: <arch>.attention.value_length)"
    ],
    "Dkvh": [
      "Dn + Dv",
      "Dn + Dv"
    ],
    "KH": [
      "H * Dkvh",
      "H * Dkvh"
    ],
    "HV": [
      "H * Dv",
      "H * Dv"
    ]
  },
  "dims_hybrid": {
    "Hk": [
      "linear_num_key_heads",
      "<arch>.ssm.group_count"
    ],
    "Hv": [
      "linear_num_value_heads",
      "<arch>.ssm.time_step_rank"
    ],
    "Dk": [
      "linear_key_head_dim",
      "<arch>.ssm.state_size"
    ],
    "Dv": [
      "linear_value_head_dim",
      "<arch>.ssm.inner_size / Hv"
    ],
    "Kc": [
      "linear_conv_kernel_dim | conv_kernel | d_conv",
      "<arch>.ssm.conv_kernel"
    ],
    "Dqk": [
      "Hk * Dk",
      "Hk * Dk"
    ],
    "Dvv": [
      "Hv * Dv",
      "<arch>.ssm.inner_size"
    ],
    "C": [
      "2*Hk*Dk + Hv*Dv (conv channels)",
      "2*Hk*Dk + Hv*Dv"
    ],
    "R": [
      "Hv / Hk",
      "Hv / Hk"
    ],
    "U": [
      "1 (unit axis)",
      "1"
    ],
    "G": [
      "num_attention_heads / num_key_value_heads",
      "<arch>.attention.head_count / <arch>.attention.head_count_kv"
    ],
    "Dqg": [
      "2 * num_attention_heads * head_dim (q + gate)",
      "2 * <arch>.attention.head_count * Dh"
    ],
    "QG": [
      "2 * head_dim",
      "2 * Dh"
    ]
  },
  "attrs": {
    "L": [
      "num_hidden_layers | n_layer (GPT-2)",
      "<arch>.block_count"
    ],
    "eps": [
      "rms_norm_eps | layer_norm_eps | layer_norm_epsilon",
      "<arch>.attention.layer_norm_rms_epsilon | <arch>.attention.layer_norm_epsilon"
    ],
    "rope": [
      "rope_theta, rope_scaling, partial_rotary_factor",
      "<arch>.rope.freq_base, <arch>.rope.scaling.type, <arch>.rope.dimension_count"
    ],
    "window": [
      "sliding_window, layer_types (sliding/full)",
      "<arch>.attention.sliding_window, <arch>.attention.sliding_window_pattern"
    ],
    "tied": [
      "tie_word_embeddings -> aliases {lm_head.weight: E}",
      "no output.weight tensor -> alias to token_embd.weight"
    ],
    "topk": [
      "num_experts_per_tok",
      "<arch>.expert_used_count"
    ],
    "shared": [
      "n_shared_experts, shared_expert_intermediate_size",
      "<arch>.expert_shared_count, <arch>.expert_shared_feed_forward_length"
    ],
    "dense_layers": [
      "first_k_dense_replace | mlp_only_layers | decoder_sparse_step",
      "<arch>.leading_dense_block_count"
    ],
    "router": [
      "scoring_func, topk_method, n_group, topk_group, routed_scaling_factor, norm_topk_prob",
      "<arch>.expert_gating_func, <arch>.expert_group_count, <arch>.expert_group_used_count, <arch>.expert_weights_scale, <arch>.expert_weights_norm"
    ],
    "layer_types": [
      "layer_types | full_attention_interval | attn_layer_indices",
      "<arch>.full_attention_interval"
    ],
    "mamba": [
      "state_size | d_state, expand, n_groups, chunk_size",
      "<arch>.ssm.state_size, <arch>.ssm.inner_size, <arch>.ssm.group_count"
    ],
    "text": [
      "text_config.* (decoder keys; checkpoint prefix model.language_model.)",
      "main .gguf holds the LM"
    ],
    "vision": [
      "vision_config: hidden_size, num_hidden_layers, num_attention_heads, intermediate_size, patch_size, image_size, spatial_merge_size, temporal_patch_size",
      "mmproj-*.gguf: clip.vision.embedding_length, clip.vision.block_count, clip.vision.attention.head_count, clip.vision.feed_forward_length, clip.vision.patch_size, clip.vision.image_size, clip.vision.spatial_merge_size, clip.projector_type"
    ],
    "projector": [
      "projector_hidden_act, image_token_id | image_token_index, mm_projector_type",
      "clip.vision.projector_type, clip.vision.projection_dim, mm.* tensors"
    ],
    "audio": [
      "audio_config (if present)",
      "clip.audio.embedding_length, clip.audio.block_count, clip.audio.projector_type"
    ]
  },
  "examples": [
    "json/qwen3.8-27b-fp8.json (text tower only; checkpoint prefix model.language_model.)"
  ],
  "dims_format": "symbol -> [safetensors config.json expression, GGUF KV expression]; <arch> = general.architecture; B, T, q, k are example sizes picked by the builder",
  "safetensors": {
    "files": [
      "config.json",
      "model.safetensors.index.json (sharded: weight_map tensor->file)",
      "*.safetensors header: 8-byte LE length + JSON {name: {dtype, shape, data_offsets}, __metadata__}"
    ],
    "tensor_fields": [
      "name -> tensors[].checkpoint_key",
      "shape -> tensors[].shape",
      "dtype -> tensors[].dtype"
    ],
    "quantization": "config.json quantization_config {quant_method, weight_block_size, fmt}; scale tensors *_scale_inv / *.scales"
  },
  "gguf": {
    "files": [
      "*.gguf header: magic, version, tensor_count, kv_count, KV metadata, tensor infos"
    ],
    "kv": [
      "general.architecture",
      "general.name",
      "general.file_type",
      "general.quantization_version",
      "general.alignment",
      "tokenizer.ggml.model",
      "tokenizer.ggml.tokens"
    ],
    "tensor_fields": [
      "name (llama.cpp scheme: token_embd, blk.N.attn_q, blk.N.ffn_gate_exps, output, output_norm) -> tensors[].checkpoint_key, kept as-is (see json/mixtral-8x7b-instruct-q4km.json)",
      "dims (reversed vs PyTorch order) -> shape",
      "ggml type (Q4_K, Q8_0, F16, ...) -> dtype"
    ],
    "split_files": "multi-part *-00001-of-0000N.gguf: tensors spread across parts; KV in part 1"
  },
  "graph_json": "tensormorph-viz-graph v1 (json/*.json): model.name, dims, axes, aliases, tensors[] (checkpoint_key, shape, dtype), ops[], edges[], groups, multiplications, totals"
}
